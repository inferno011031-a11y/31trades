{
  "$schema": "https://design-tokens.org/schema.json",
  "description": "31Trades three-layer design tokens. Source of truth for assets/tokens.css (generated by the design-system skill). Layer 1 primitives are raw values; layer 2 semantic aliases keep the --tm-* names used across trademind-theme.css and all pages; layer 3 component tokens wire the major components.",
  "primitive": {
    "color": {
      "obsidian": {
        "950": { "$value": "#0a0c10", "$type": "color" },
        "900": { "$value": "#0d1016", "$type": "color" },
        "800": { "$value": "#121620", "$type": "color" },
        "750": { "$value": "#161b26", "$type": "color" },
        "700": { "$value": "#181e2c", "$type": "color" }
      },
      "alpha": {
        "border-subtle": { "$value": "rgba(255, 255, 255, 0.06)", "$type": "color" },
        "border-strong": { "$value": "rgba(255, 255, 255, 0.10)", "$type": "color" }
      },
      "text": {
        "bright": { "$value": "#f1f5f9", "$type": "color" },
        "muted": { "$value": "#94a3b8", "$type": "color" },
        "dim": { "$value": "#64748b", "$type": "color" }
      },
      "indigo": {
        "300": { "$value": "#a5b4fc", "$type": "color" },
        "400": { "$value": "#818cf8", "$type": "color" },
        "500": { "$value": "#6366f1", "$type": "color" },
        "600": { "$value": "#4f46e5", "$type": "color" }
      },
      "emerald": { "400": { "$value": "#34d399", "$type": "color" } },
      "red": { "400": { "$value": "#f87171", "$type": "color" } },
      "amber": { "400": { "$value": "#fbbf24", "$type": "color" } },
      "blue": { "400": { "$value": "#60a5fa", "$type": "color" } }
    },
    "font": {
      "sans": { "$value": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "$type": "fontFamily" }
    },
    "radius": {
      "xs": { "$value": "6px", "$type": "dimension" },
      "sm": { "$value": "8px", "$type": "dimension" },
      "md": { "$value": "10px", "$type": "dimension" },
      "lg": { "$value": "12px", "$type": "dimension" },
      "xl": { "$value": "14px", "$type": "dimension" },
      "2xl": { "$value": "16px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "300ms", "$type": "duration" }
    },
    "space": {
      "1": { "$value": "4px", "$type": "dimension" },
      "2": { "$value": "8px", "$type": "dimension" },
      "3": { "$value": "12px", "$type": "dimension" },
      "4": { "$value": "16px", "$type": "dimension" },
      "5": { "$value": "20px", "$type": "dimension" },
      "6": { "$value": "24px", "$type": "dimension" },
      "8": { "$value": "32px", "$type": "dimension" }
    }
  },
  "semantic": {
    "tm": {
      "bg": { "$value": "var(--primitive-color-obsidian-950)", "$type": "color" },
      "bg-elev": { "$value": "var(--primitive-color-obsidian-900)", "$type": "color" },
      "card": { "$value": "var(--primitive-color-obsidian-800)", "$type": "color" },
      "card-2": { "$value": "var(--primitive-color-obsidian-750)", "$type": "color" },
      "hover": { "$value": "var(--primitive-color-obsidian-700)", "$type": "color" },
      "border": { "$value": "var(--primitive-color-alpha-border-subtle)", "$type": "color" },
      "border-2": { "$value": "var(--primitive-color-alpha-border-strong)", "$type": "color" },
      "text": { "$value": "var(--primitive-color-text-bright)", "$type": "color" },
      "muted": { "$value": "var(--primitive-color-text-muted)", "$type": "color" },
      "dim": { "$value": "var(--primitive-color-text-dim)", "$type": "color" },
      "accent": { "$value": "var(--primitive-color-indigo-400)", "$type": "color" },
      "accent-2": { "$value": "var(--primitive-color-indigo-500)", "$type": "color" },
      "green": { "$value": "var(--primitive-color-emerald-400)", "$type": "color" },
      "red": { "$value": "var(--primitive-color-red-400)", "$type": "color" },
      "amber": { "$value": "var(--primitive-color-amber-400)", "$type": "color" },
      "purple": { "$value": "var(--primitive-color-indigo-300)", "$type": "color" },
      "blue": { "$value": "var(--primitive-color-blue-400)", "$type": "color" },
      "sans": { "$value": "var(--primitive-font-sans)", "$type": "fontFamily" },
      "mono": { "$value": "var(--primitive-font-mono)", "$type": "fontFamily" }
    }
  },
  "component": {
    "btn": {
      "primary-bg": { "$value": "linear-gradient(135deg, var(--tm-accent-2), #4f46e5)", "$type": "color" },
      "primary-border": { "$value": "rgba(129, 140, 248, 0.35)", "$type": "color" },
      "primary-shadow": { "$value": "0 0 22px rgba(99, 102, 241, 0.30), inset 0 1px 0 rgba(255, 255, 255, 0.15)", "$type": "shadow" },
      "primary-shadow-hover": { "$value": "0 0 30px rgba(99, 102, 241, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.15)", "$type": "shadow" },
      "secondary-bg": { "$value": "var(--tm-card-2)", "$type": "color" },
      "ghost-bg": { "$value": "rgba(255, 255, 255, 0.03)", "$type": "color" },
      "danger-bg": { "$value": "rgba(248, 113, 113, 0.10)", "$type": "color" }
    },
    "card": {
      "bg": { "$value": "var(--tm-card)", "$type": "color" },
      "border": { "$value": "var(--tm-border)", "$type": "color" },
      "border-hover": { "$value": "var(--tm-border-2)", "$type": "color" },
      "bg-hover": { "$value": "var(--tm-hover)", "$type": "color" },
      "radius": { "$value": "var(--tm-radius-card, 12px)", "$type": "dimension" }
    },
    "modal": {
      "bg": { "$value": "var(--tm-card)", "$type": "color" },
      "border": { "$value": "var(--tm-border-2)", "$type": "color" },
      "radius": { "$value": "16px", "$type": "dimension" },
      "shadow": { "$value": "0 24px 60px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.06)", "$type": "shadow" },
      "backdrop": { "$value": "rgba(0, 0, 0, 0.70)", "$type": "color" }
    },
    "input": {
      "bg": { "$value": "var(--tm-bg)", "$type": "color" },
      "border": { "$value": "var(--tm-border-2)", "$type": "color" },
      "focus-border": { "$value": "rgba(129, 140, 248, 0.55)", "$type": "color" },
      "focus-ring": { "$value": "0 0 0 3px rgba(99, 102, 241, 0.15)", "$type": "shadow" },
      "radius": { "$value": "10px", "$type": "dimension" }
    }
  }
}
