# ============================================================================
# 31TRADES — Environment configuration
# ----------------------------------------------------------------------------
# Copy this file to .env and fill in your values. Never commit .env.
#
#   cp .env.example .env
#
# Everything is optional: without SUPABASE_DB_URL the server runs in pure
# local-first mode (data/db.json + browser localStorage), exactly as before.
# ============================================================================

# --- Supabase project --------------------------------------------------------
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only key — NEVER ship this to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres connection string ----------------------------------------------
# Dashboard → Project Settings → Database → Connection string → URI (Node.js)
# Direct:   postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres
# Pooled:   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Keep true for Supabase (their pooler needs SSL with rejectUnauthorized:false).
# Set to false only for local Postgres without SSL.
SUPABASE_DB_SSL=true

# --- Auth --------------------------------------------------------------------
# Auth is ON by default: every /api/* call (except /api/auth/* and /api/health)
# requires a Bearer token from Supabase GoTrue (sign in at auth.html).
# Set to 'off' only for local dev / testing — the server then runs in
# anonymous mode (single local partition, no login).
# TRADEMIND_AUTH=off

# --- Backtesting market data -----------------------------------------------
# Default: REAL TradingView candles via @mathieuc/tradingview (guest websocket,
# no API key), cached on disk for 6h, with a deterministic synthetic fallback
# when TradingView is unreachable. Set TRADEMIND_TV=off to force the synthetic
# path (offline hosts / tests).
# TRADEMIND_TV=off

# --- Market Replay (true TradingView replay mode) ---------------------------
# TradingView's native bar-by-bar replay is a paid feature. To use it in the
# Market Replay page, paste the sessionid/signature cookies from a logged-in
# TradingView account (DevTools → Application → Cookies → tradingview.com).
# Without them the page replays the same real history locally, bar by bar.
# TRADEMIND_TV_SESSION=your_sessionid_cookie
# TRADEMIND_TV_SIGNATURE=your_signature_cookie

# Economic calendar provider key (FMP). Optional — keyless ForexFactory mirror is the fallback.
ECON_CALENDAR_KEY=
